    <PopupInquiryForm
      title="Planning a Large Folding Door Opening?"
      lead="Send us your opening size and project location. Our team will review whether LIKI 140 or LIKI 145 is the better fit."
      source="LIKI 140 / 145 Ultra-Large Folding Door Systems Popup"
      subject="LIKI 140 / 145 Popup Inquiry"
    />
    <script>
      (() => {
        const toggle = document.querySelector("[data-floating-nav-toggle]");
        if (toggle) {
          const mobileQuery = window.matchMedia("(max-width: 768px)");

          const setNavState = (open) => {
            document.body.dataset.floatingNavOpen = String(open);
            toggle.textContent = open ? "×" : "Explore";
            toggle.setAttribute("aria-expanded", String(open));
            toggle.setAttribute(
              "aria-label",
              open ? "Hide section navigation" : "Show section navigation"
            );
          };

          setNavState(!mobileQuery.matches);
          toggle.addEventListener("click", () => {
            setNavState(document.body.dataset.floatingNavOpen !== "true");
          });
        }
      })();

      (() => {
        const showcase = document.querySelector("[data-opening-showcase]");
        const image = showcase?.querySelector("[data-opening-image]");
        const stateButtons = showcase?.querySelectorAll("[data-state]");
        if (!showcase || !image || !stateButtons?.length) return;

        const states = {
          closed: {
            src: "/images/optimized/closed.webp",
            alt: "LIKI folding system closed across an ultra-large coastal living opening"
          },
          partial: {
            src: "/images/optimized/partial.webp",
            alt: "LIKI folding system partially open to show the opening transformation"
          },
          open: {
            src: "/images/optimized/open.webp",
            alt: "LIKI folding system fully open, transforming the living space toward the coastal view"
          }
        };

        const setState = (state) => {
          const next = states[state];
          if (!next || image.dataset.currentState === state) return;

          image.dataset.currentState = state;
          image.classList.add("is-changing");

          window.setTimeout(() => {
            image.setAttribute("src", next.src);
            image.setAttribute("alt", next.alt);
            window.requestAnimationFrame(() => {
              image.classList.remove("is-changing");
            });
          }, 180);

          stateButtons.forEach((button) => {
            const isActive = button.dataset.state === state;
            button.classList.toggle("is-active", isActive);
            button.setAttribute("aria-pressed", String(isActive));
          });
        };

        image.dataset.currentState = "open";
        stateButtons.forEach((button) => {
          button.addEventListener("click", () => setState(button.dataset.state));
        });
      })();

      (() => {
        const carousels = document.querySelectorAll("[data-feature-corner-carousel]");
        if (!carousels.length) return;

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduceMotion) return;

        carousels.forEach((carousel) => {
          const slides = carousel.querySelectorAll("[data-feature-corner-slide]");
          if (slides.length < 2) return;

          let activeIndex = 0;

          window.setInterval(() => {
            slides[activeIndex].classList.remove("is-active");
            activeIndex = (activeIndex + 1) % slides.length;
            slides[activeIndex].classList.add("is-active");
          }, 4000);
        });
      })();

      (() => {
        const carousels = document.querySelectorAll("[data-feature-card-carousel]");
        if (!carousels.length) return;

        carousels.forEach((carousel) => {
          const slides = Array.from(carousel.querySelectorAll("[data-feature-card-slide]"));
          const dots = Array.from(carousel.querySelectorAll("[data-feature-card-dot]"));
          const prev = carousel.querySelector("[data-feature-card-prev]");
          const next = carousel.querySelector("[data-feature-card-next]");
          if (slides.length < 2 || !prev || !next) return;

          let activeIndex = 0;

          const setSlide = (nextIndex) => {
            activeIndex = (nextIndex + slides.length) % slides.length;
            carousel.dataset.activeIndex = String(activeIndex);

            slides.forEach((slide, index) => {
              slide.classList.toggle("is-active", index === activeIndex);
              slide.setAttribute("aria-hidden", String(index !== activeIndex));
            });

            dots.forEach((dot, index) => {
              dot.classList.toggle("is-active", index === activeIndex);
            });
          };

          slides.forEach((slide, index) => {
            slide.setAttribute("aria-hidden", String(index !== activeIndex));
          });

          prev.addEventListener("click", () => setSlide(activeIndex - 1));
          next.addEventListener("click", () => setSlide(activeIndex + 1));
        });
      })();

      (() => {
        const showcase = document.querySelector("[data-project-showcase]");
        if (!showcase) return;

        const mainImage = showcase.querySelector("[data-showcase-main-image]");
        const loc = showcase.querySelector("[data-showcase-loc]");
        const type = showcase.querySelector("[data-showcase-type]");
        const feature = showcase.querySelector("[data-showcase-feature]");
        const title = showcase.querySelector("[data-showcase-title]");
        const text = showcase.querySelector("[data-showcase-text]");
        const count = showcase.querySelector("[data-showcase-count]");
        const prev = showcase.querySelector("[data-showcase-prev]");
        const next = showcase.querySelector("[data-showcase-next]");
        const thumbsPrev = showcase.querySelector("[data-showcase-thumbs-prev]");
        const thumbsNext = showcase.querySelector("[data-showcase-thumbs-next]");
        const thumbs = Array.from(showcase.querySelectorAll("[data-showcase-thumb]"));
        if (!mainImage || !loc || !type || !feature || !title || !text || !count || !thumbs.length) return;

        let activeIndex = 0;
        let thumbStart = 0;

        const getVisibleCount = () => {
          if (window.matchMedia("(max-width: 560px)").matches) return 4;
          if (window.matchMedia("(max-width: 1080px)").matches) return 4;
          return 5;
        };

        const renderThumbs = () => {
          const visibleCount = getVisibleCount();
          if (activeIndex < thumbStart) thumbStart = activeIndex;
          if (activeIndex >= thumbStart + visibleCount) thumbStart = activeIndex - visibleCount + 1;
          thumbStart = Math.max(0, Math.min(thumbStart, Math.max(0, thumbs.length - visibleCount)));

          thumbs.forEach((thumb, index) => {
            const isVisible = index >= thumbStart && index < thumbStart + visibleCount;
            const isActive = index === activeIndex;
            thumb.hidden = !isVisible;
            thumb.classList.toggle("is-active", isActive);
            thumb.setAttribute("aria-pressed", String(isActive));
          });
        };

        const setProject = (nextIndex) => {
          activeIndex = (nextIndex + thumbs.length) % thumbs.length;
          const thumb = thumbs[activeIndex];
          if (!thumb) return;

          mainImage.classList.add("is-switching");
          window.setTimeout(() => {
            mainImage.src = thumb.dataset.image || mainImage.src;
            mainImage.alt = thumb.dataset.alt || "";
            loc.textContent = thumb.dataset.loc || "";
            type.textContent = thumb.dataset.type || "";
            feature.textContent = thumb.dataset.feature || "";
            title.textContent = thumb.dataset.title || "";
            text.textContent = thumb.dataset.text || "";
            count.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(thumbs.length).padStart(2, "0")}`;
            renderThumbs();
            window.requestAnimationFrame(() => mainImage.classList.remove("is-switching"));
          }, 160);
        };

        prev?.addEventListener("click", () => setProject(activeIndex - 1));
        next?.addEventListener("click", () => setProject(activeIndex + 1));
        thumbsPrev?.addEventListener("click", () => setProject(activeIndex - 1));
        thumbsNext?.addEventListener("click", () => setProject(activeIndex + 1));

        thumbs.forEach((thumb, index) => {
          thumb.addEventListener("click", () => setProject(index));
        });

        window.addEventListener("resize", renderThumbs, { passive: true });
        renderThumbs();
      })();

      (() => {
        const cards = document.querySelectorAll("[data-living-carousel]");
        if (!cards.length) return;

        const imageExists = (src) =>
          new Promise((resolve) => {
            const image = new Image();
            image.onload = () => resolve(src);
            image.onerror = () => resolve(null);
            image.src = src;
          });

        cards.forEach(async (card, cardIndex) => {
          const image = card.querySelector(".living-card__image");
          const dotsRoot = card.querySelector(".living-card__dots");
          if (!image || !dotsRoot) return;

          let candidates = [];
          try {
            candidates = JSON.parse(card.dataset.slides || "[]");
          } catch {
            candidates = [];
          }

          const available = (await Promise.all(candidates.map(imageExists))).filter(Boolean);
          if (!available.length) return;

          let activeIndex = 0;
          let paused = false;
          const dots = available.map((_, index) => {
            const dot = document.createElement("span");
            dot.className = index === 0 ? "is-active" : "";
            dotsRoot.append(dot);
            return dot;
          });

          const setSlide = (nextIndex) => {
            if (nextIndex === activeIndex || !available[nextIndex]) return;
            activeIndex = nextIndex;
            image.classList.add("is-fading");

            window.setTimeout(() => {
              image.src = available[activeIndex];
              dots.forEach((dot, index) => {
                dot.classList.toggle("is-active", index === activeIndex);
              });
              window.requestAnimationFrame(() => {
                image.classList.remove("is-fading");
              });
            }, 420);
          };

          if (available.length > 1) {
            card.addEventListener("mouseenter", () => {
              paused = true;
            });
            card.addEventListener("mouseleave", () => {
              paused = false;
            });

            window.setInterval(() => {
              if (paused) return;
              setSlide((activeIndex + 1) % available.length);
            }, 6500 + cardIndex * 600);
          }
        });
      })();

      (() => {
        const triggers = document.querySelectorAll("[data-system-preference]");
        const quoteSection = document.querySelector("#quote");
        const quoteTitle = document.querySelector("#quote-title");
        const mainForm = quoteSection?.querySelector("[data-inquiry-form]");
        const hiddenPreference = mainForm?.querySelector("[data-preferred-system-field]");
        const visibleSystem = mainForm?.querySelector("#interested-system");
        if (!triggers.length || !quoteSection || !mainForm || !hiddenPreference) return;

        const setPreference = (system, formTitle) => {
          hiddenPreference.value = system;
          if (visibleSystem) visibleSystem.value = system;
          if (quoteTitle && formTitle) quoteTitle.textContent = formTitle;
        };

        visibleSystem?.addEventListener("change", () => {
          hiddenPreference.value = visibleSystem.value.includes("LIKI")
            ? visibleSystem.value
            : "";
        });

        triggers.forEach((trigger) => {
          trigger.addEventListener("click", (event) => {
            event.preventDefault();
            setPreference(trigger.dataset.systemPreference || "", trigger.dataset.systemFormTitle || "");
            quoteSection.scrollIntoView({ behavior: "smooth", block: "start" });
          });
        });
      })();
    </script>
    <InquiryClientScript />
