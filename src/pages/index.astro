  }

  .living-experience__note a {
    color: var(--bronze);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .system-comparison {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(circle at 18% 18%, rgba(180, 147, 101, 0.2), transparent 30%),
      radial-gradient(circle at 82% 28%, rgba(84, 91, 94, 0.34), transparent 36%),
      radial-gradient(circle at 50% 112%, rgba(180, 147, 101, 0.13), transparent 34%),
      linear-gradient(135deg, #090b0a 0%, #111312 46%, #151411 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .system-comparison::before,
  .system-comparison::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .system-comparison::before {
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.44), transparent 24%, transparent 76%, rgba(0, 0, 0, 0.52)),
      linear-gradient(180deg, rgba(255, 255, 255, 0.045), transparent 32%, rgba(0, 0, 0, 0.34));
  }

  .system-comparison::after {
    inset: 1px;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(circle at 50% 36%, black, transparent 72%);
    opacity: 0.42;
  }

  .system-comparison__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(22px, 2.4vw, 34px);
  }

  .system-card {
    display: flex;
    overflow: hidden;
    flex-direction: column;
    min-height: 100%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    background:
      linear-gradient(155deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.032) 52%, rgba(180, 147, 101, 0.08)),
      rgba(255, 255, 255, 0.045);
    box-shadow: 0 28px 78px rgba(0, 0, 0, 0.38);
    backdrop-filter: blur(16px);
  }

  .system-card--140 {
    border-color: rgba(211, 174, 126, 0.24);
  }

  .system-card--145 {
    border-color: rgba(181, 188, 189, 0.22);
  }

  .system-card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    margin: 0;
    overflow: hidden;
    background: #171916;
  }

  .system-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(9, 11, 10, 0.02), rgba(9, 11, 10, 0.34)),
      linear-gradient(90deg, rgba(9, 11, 10, 0.22), transparent 42%, rgba(9, 11, 10, 0.1));
    pointer-events: none;
  }

  .system-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.01);
    transition:
      transform 700ms cubic-bezier(.22,.61,.36,1),
      filter 700ms cubic-bezier(.22,.61,.36,1);
  }

  .system-card:hover .system-card__media img {
    filter: saturate(1.05) contrast(1.03);
    transform: scale(1.035);
  }

  .system-card__media figcaption {
    position: absolute;
    left: clamp(18px, 2vw, 26px);
    bottom: clamp(16px, 2vw, 22px);
    z-index: 1;
    max-width: calc(100% - 44px);
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .system-card__body {
    display: grid;
    flex: 1;
    grid-template-rows: auto auto auto auto 1fr auto;
    padding: clamp(24px, 3vw, 38px);
  }

  .system-card__position {
    margin: 0 0 10px;
    color: var(--bronze);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .system-card h3 {
    margin: 0 0 14px;
    color: var(--warm);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.85rem, 3.4vw, 2.65rem);
    font-weight: 500;
    line-height: 1.04;
  }

  .system-card p {
    color: rgba(255, 255, 255, 0.72);
  }

  .system-card__best {
    margin-top: clamp(24px, 2.8vw, 34px);
    padding: 20px 0 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }

  .system-card__best > span {
    display: block;
    margin-bottom: 14px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .system-card__best ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .system-card__best li {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    min-width: 0;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .system-card__best li span {
    position: relative;
    display: inline-flex;
    width: 18px;
    height: 18px;
    border: 1px solid rgba(180, 147, 101, 0.48);
    border-radius: 999px;
    background: rgba(180, 147, 101, 0.08);
  }

  .system-card__best li span::before,
  .system-card__best li span::after {
    content: "";
    position: absolute;
    background: rgba(245, 232, 208, 0.72);
  }

  .system-card__best li span::before {
    left: 5px;
    right: 5px;
    top: 8px;
    height: 1px;
  }

  .system-card__best li span::after {
    top: 5px;
    bottom: 5px;
    left: 8px;
    width: 1px;
  }

  .system-card__specs {
    display: grid;
    gap: 0;
    align-self: end;
    margin: clamp(24px, 3vw, 34px) 0 0;
    padding: 6px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .system-card__specs div {
    display: grid;
    grid-template-columns: minmax(112px, 1fr) auto;
    gap: 18px;
    align-items: baseline;
    padding: 15px 0;
  }

  .system-card__specs div + div {
    border-top: 1px solid rgba(255, 255, 255, 0.075);
  }

  .system-card__specs dt,
  .system-card__specs dd {
    margin: 0;
  }

  .system-card__specs dt {
    color: rgba(255, 255, 255, 0.48);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .system-card__specs dd {
    color: rgba(255, 255, 255, 0.9);
    font-weight: 900;
    letter-spacing: 0.01em;
    text-align: right;
  }

  .system-card__cta {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 12px;
    margin-top: clamp(24px, 3vw, 34px);
    padding: 12px 0;
    border-bottom: 1px solid rgba(180, 147, 101, 0.46);
    color: var(--warm);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .system-card__cta span {
    color: var(--bronze);
    font-size: 1rem;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .system-card__cta:hover,
  .system-card__cta:focus-visible {
    border-color: var(--bronze);
    color: #d8bd91;
    outline: none;
    transform: translateY(-1px);
  }

  .system-card__cta:hover span,
  .system-card__cta:focus-visible span {
    transform: translateX(4px);
  }

