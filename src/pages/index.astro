  }

  .living-card__content span {
    display: inline-flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    background: rgba(180, 147, 101, 0.88);
    color: #fff8ec;
    font-size: 0.78rem;
    font-weight: 900;
  }

  .living-card h3 {
