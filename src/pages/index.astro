    background:
      linear-gradient(180deg, rgba(8, 10, 9, 0.04), rgba(8, 10, 9, 0.12)),
      linear-gradient(90deg, rgba(8, 10, 9, 0.08), transparent 44%, rgba(8, 10, 9, 0.08));
    pointer-events: none;
