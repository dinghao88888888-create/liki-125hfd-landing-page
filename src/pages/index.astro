    font-size: 0.98rem;
  }

  .living-experience__note {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 22px;
    align-items: center;
    margin-top: 42px;
    padding-top: 34px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .living-experience__note span {
    color: var(--bronze);
    font-size: 2.15rem;
    line-height: 1;
  }

  .living-experience__note p {
    max-width: 720px;
    margin: 0;
