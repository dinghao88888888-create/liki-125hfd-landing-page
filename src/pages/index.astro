  .feature-card-carousel {
    position: relative;
    isolation: isolate;
    min-height: 260px;
    margin: 0;
    overflow: hidden;
    border-radius: 8px;
    aspect-ratio: 21 / 10;
    background: #171916;
    box-shadow: 0 20px 54px rgba(17, 19, 18, 0.13);
