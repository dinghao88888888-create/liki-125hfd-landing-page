  .bespoke-sizing {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 78% 18%, rgba(180, 147, 101, 0.18), transparent 30%),
      linear-gradient(135deg, #f7f1e5 0%, #ede3d4 44%, #f8f4ec 100%);
  }

  .bespoke-sizing::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(27, 29, 27, 0.045), transparent 28%, transparent 78%, rgba(27, 29, 27, 0.035)),
      linear-gradient(180deg, rgba(255, 255, 255, 0.42), transparent 42%, rgba(180, 147, 101, 0.08));
    pointer-events: none;
  }

  .bespoke-sizing__grid {
    position: relative;
    z-index: 1;
    width: min(1440px, calc(100% - 64px));
    display: grid;
    grid-template-columns: minmax(0, 0.4fr) minmax(0, 0.6fr);
    gap: clamp(36px, 4.6vw, 76px);
    align-items: center;
  }

  .bespoke-sizing__content {
    min-width: 0;
  }

  .bespoke-sizing h2 {
    max-width: 520px;
    color: #171916;
    line-height: 0.96;
  }

  .bespoke-sizing h2 span {
    display: block;
  }

  .bespoke-sizing__copy {
    display: grid;
    gap: 16px;
    max-width: 520px;
    margin-top: clamp(24px, 2.8vw, 32px);
  }

  .bespoke-sizing__copy p {
    margin: 0;
    color: rgba(27, 29, 27, 0.68);
    font-size: clamp(1rem, 1.2vw, 1.08rem);
    line-height: 1.72;
  }

  .bespoke-review {
    max-width: 650px;
    margin-top: clamp(38px, 3.8vw, 54px);
    padding-top: clamp(28px, 3vw, 38px);
    border-top: 1px solid rgba(27, 29, 27, 0.12);
  }

  .bespoke-review__title {
    margin: 0 0 24px;
    color: rgba(134, 109, 73, 0.86);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .bespoke-review__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-bottom: 1px solid rgba(27, 29, 27, 0.11);
  }

  .bespoke-review__item {
    display: grid;
    gap: 10px;
    align-content: center;
    justify-items: center;
    min-height: 104px;
    padding: 22px clamp(10px, 1.1vw, 16px);
    color: rgba(27, 29, 27, 0.4);
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .bespoke-review__item:not(:nth-child(4n + 1)) {
    border-left: 1px solid rgba(27, 29, 27, 0.12);
  }

  .bespoke-review__item:nth-child(n + 5) {
    border-top: 1px solid rgba(27, 29, 27, 0.11);
  }

  .bespoke-review__item:hover {
    color: rgba(27, 29, 27, 0.54);
    transform: translateY(-1px);
  }

  .bespoke-review__item svg {
    width: 30px;
    height: 30px;
    color: rgba(27, 29, 27, 0.34);
    stroke-width: 1.35;
    stroke-linecap: square;
    stroke-linejoin: miter;
    transition: color 180ms ease;
  }

  .bespoke-review__item:hover svg {
    color: rgba(134, 109, 73, 0.5);
  }

  .bespoke-review__item span {
    color: rgba(27, 29, 27, 0.7);
    font-size: clamp(0.78rem, 0.84vw, 0.86rem);
    font-weight: 600;
    letter-spacing: 0.015em;
    line-height: 1.32;
    text-align: center;
  }

  .bespoke-sizing__action {
    display: grid;
    gap: 18px;
    margin-top: clamp(32px, 3.5vw, 44px);
    justify-items: start;
  }

  .bespoke-sizing__cta {
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 15px 22px;
    border: 1px solid rgba(134, 109, 73, 0.4);
    border-radius: 4px;
    background: var(--bronze);
    box-shadow: 0 18px 36px rgba(77, 58, 33, 0.16);
    color: #17140e;
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .bespoke-sizing__cta svg {
    width: 18px;
    height: 18px;
    transition: transform 180ms ease;
  }

  .bespoke-sizing__cta:hover,
  .bespoke-sizing__cta:focus-visible {
    background: #c7a675;
    box-shadow: 0 22px 44px rgba(77, 58, 33, 0.2);
    outline: none;
    transform: translateY(-2px);
  }

  .bespoke-sizing__cta:hover svg,
  .bespoke-sizing__cta:focus-visible svg {
    transform: translateX(3px);
  }

  .bespoke-sizing__action p {
    max-width: 440px;
    margin: 0;
    color: rgba(27, 29, 27, 0.5);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .bespoke-sizing__media {
    position: relative;
    width: 100%;
    min-height: clamp(660px, 40vw, 760px);
    margin: 0;
  }

  .bespoke-sizing__media img {
    width: 100%;
    height: clamp(660px, 40vw, 760px);
    border-radius: 18px;
    box-shadow:
      0 28px 78px rgba(52, 40, 26, 0.22),
      0 2px 0 rgba(255, 255, 255, 0.42) inset;
    object-fit: cover;
    object-position: center center;
    transition:
      box-shadow 360ms ease,
      filter 360ms ease,
      transform 600ms cubic-bezier(.22,.61,.36,1);
  }

  .bespoke-sizing__media:hover img {
    filter: saturate(1.03) contrast(1.02);
    box-shadow:
      0 34px 88px rgba(52, 40, 26, 0.27),
      0 2px 0 rgba(255, 255, 255, 0.42) inset;
    transform: scale(1.012);
  }

  @supports (animation-timeline: view()) {
    .bespoke-sizing [data-bespoke-reveal],
    .bespoke-review__item {
      opacity: 0;
      animation: bespokeFadeUp 680ms cubic-bezier(.22,.61,.36,1) both;
      animation-timeline: view();
      animation-range: entry 8% cover 32%;
    }

    .bespoke-review__item:nth-child(2) {
      animation-delay: 60ms;
    }

    .bespoke-review__item:nth-child(3) {
      animation-delay: 120ms;
    }

    .bespoke-review__item:nth-child(4) {
      animation-delay: 180ms;
    }

    .bespoke-review__item:nth-child(5) {
      animation-delay: 240ms;
    }

    .bespoke-review__item:nth-child(6) {
      animation-delay: 300ms;
    }

    .bespoke-review__item:nth-child(7) {
      animation-delay: 360ms;
    }

    .bespoke-review__item:nth-child(8) {
      animation-delay: 420ms;
    }

    .bespoke-sizing__media {
      animation: bespokeImageDrift linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 48%;
    }
  }

  .opening-experience {
