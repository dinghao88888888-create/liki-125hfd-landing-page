const previewFaqs = [
  {
    q: "Which system should I choose, LIKI 140 or LIKI 145?",
    a: "LIKI 140 is the luxury residential standard for premium folding door projects. LIKI 145 is the ultra-large architectural system for taller panels, wider production limits, and heavier single-panel loads."
  },
  {
    q: "Can LIKI support Florida coastal villa projects?",
    a: "Yes. Coastal requirements can be reviewed around exposure, finish, hardware, glass package, drainage, and project-specific performance documents before production is confirmed."
  },
  {
    q: "What is the maximum opening area?",
    a: "Project configurations may support opening areas up to 1,033 ft2 / 96 m2, depending on layout, panel count, structure, glass package, and local requirements."
  },
  {
    q: "What glazing packages are available?",
    a: "Standard insulated glazing options include 6+12Ar+6 and 8+12Ar+8 with fully tempered safety glass. Optional argon-filled glass, decorative glass, and art glass can be reviewed by project."
  },
  {
    q: "Are BRIO hardware and HOPPE handles available?",
    a: "Yes. LIKI can coordinate BRIO hardware and HOPPE handles as part of the system package, subject to configuration, finish, and project requirements."
  },
  {
    q: "Can architects get drawings and technical data?",
    a: "Yes. CAD coordination, shop drawings, section details, configuration review, and performance information are available for qualified projects before fabrication."
  },
  {
    q: "Can the system be used for penthouses and hospitality projects?",
    a: "Yes. LIKI 140 and 145 can be reviewed for New York penthouses, California luxury residences, Florida coastal villas, and high-end commercial lounge or hospitality projects."
  },
  {
    q: "What information do you need for a quote?",
    a: "Send the rough opening width and height, project location, preferred system, panel configuration, drawings if available, glass requirements, finish preference, and target timeline."
  },
  {
    q: "Are certifications available?",
    a: "NFRC, AAMA, ASTM, Florida NOA, Title 24, testing documents, and performance data may be available depending on the product, configuration, glass package, and project requirements."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "LIKI 140 and 145 Ultra-Large Folding Door Systems",
  brand: {
    "@type": "Brand",
    name: "LIKI Systems"
  },
  description,
  category: "Ultra-large aluminum folding door system",
  url: canonical,
  image: heroImageUrl,
  additionalProperty: [
    {
      "@type": "PropertyValue",
      name: "Maximum opening area",
      value: "Up to 1,033 ft2 / 96 m2"
    },
    {
      "@type": "PropertyValue",
      name: "LIKI 145 maximum height",
      value: "Up to 4000mm"
    },
    {
      "@type": "PropertyValue",
      name: "Minimum visible frame/sash width after closing",
      value: "60mm"
    }
  ],
  offers: {
    "@type": "Offer",
    priceSpecification: {
      "@type": "PriceSpecification",
      priceCurrency: "USD",
      description: "Project-specific quotation available upon request"
    }
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={heroImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={heroImageUrl} />
    <GoogleAnalytics />
    <MicrosoftClarity />
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </head>
  <body data-floating-nav-open="true">
    <FloatingNav items={navItems} />
    <button
      class="floating-nav-toggle"
      type="button"
      data-floating-nav-toggle
      aria-label="Hide section navigation"
      aria-expanded="true"
    >
      ×
    </button>
    <WhatsAppButton />
    <main id="top">
      <section class="hero" id="overview" aria-labelledby="hero-title">
        <ImageBlock
          className="hero__image"
          src={images.hero.src}
          alt="LIKI ultra-large folding door system opened across a luxury villa living space"
          width={images.hero.width}
          height={images.hero.height}
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero__overlay"></div>
        <div class="hero__content container">
          <p class="eyebrow">LIKI Ultra-Large Folding Door Systems</p>
          <h1 id="hero-title">Heavy-Duty Folding Glass Walls Built Around Your Opening</h1>
          <p class="hero__lead">
            Custom aluminum folding glass wall systems for North American luxury
            homes, architects, and builders — with large panels, open-corner options,
            flush thresholds, and factory-backed engineering support.
          </p>
          <ul class="hero-bullets">
            <li>Custom-built to your opening size</li>
            <li>Up to 13.123 ft (4,000 mm) leaf height</li>
            <li>Up to 1,033 ft² (96 m²) opening area</li>
            <li>90° open corner and hidden screen options</li>
            <li>Project support from drawings to delivery</li>
          </ul>
          <div class="hero__actions">
            <CTAButton label="Get a Project Quote" href="#quote" />
            <CTAButton label="View Systems" href="#systems" variant="secondary" />
          </div>
        </div>
      </section>

      <section class="hook-strip" aria-label="Why architects and owners choose LIKI">
        <div class="container hook-strip__grid">
          {hookCards.map((item) => (
            <article class="hook-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              {item.proof && <strong>{item.proof}</strong>}
            </article>
          ))}
        </div>
      </section>

      <section class="section opening-experience" aria-labelledby="problem-title">
        <div class="container opening-experience__intro">
          <p class="eyebrow">Interactive opening experience</p>
          <h2 id="problem-title">Transform the Space</h2>
          <p>
            LIKI ultra-large folding systems are engineered for oversized
            residential openings, coastal environments, and modern indoor-outdoor
            living.
          </p>
          <p>
            Built with thermally broken aluminum architecture, each system is
            custom-configured to match the project's structural, environmental, and
            architectural requirements.
          </p>
          <ul class="opening-experience__bullets">
            <li>Energy-efficient and highly weather-resistant</li>
            <li>Effortless one-hand operation</li>
            <li>Built for oversized architectural openings</li>
          </ul>
          <CTAButton label="Talk to an Engineer" href="#quote" />
        </div>

        <div class="opening-showcase" data-opening-showcase>
          <figure class="opening-showcase__frame">
            <img
              src="/images/optimized/open.webp"
              alt="LIKI folding system fully open, transforming the living space toward the coastal view"
              data-opening-image
              loading="lazy"
            />
          </figure>

          <div class="opening-showcase__controls" aria-label="Opening transformation controls">
            <div class="opening-showcase__view" aria-label="View direction">
              <span>View</span>
              <button type="button" class="is-active" aria-pressed="true">Outside</button>
              <span>/</span>
              <button type="button" aria-pressed="false">Inside</button>
            </div>

            <div class="opening-showcase__states" aria-label="Opening state">
              <button type="button" data-state="closed" aria-pressed="false">Closed</button>
              <button type="button" data-state="partial" aria-pressed="false">Partial</button>
              <button type="button" class="is-active" data-state="open" aria-pressed="true">Open</button>
            </div>
          </div>
        </div>
      </section>

      <section class="section section--dark living-experience" id="open-living" aria-labelledby="open-living-title">
        <div class="container living-experience__grid">
          <div class="living-experience__copy">
            <p class="eyebrow">Indoor-outdoor living</p>
            <h2 id="open-living-title">
              <span>Open Living.</span>
              <span>Engineered for</span>
              <span>Demanding Sites.</span>
            </h2>
            <span class="living-experience__rule" aria-hidden="true"></span>
            <p>
              LIKI ultra-large folding doors create uninterrupted openings that
              connect people to the places they love without compromising performance.
            </p>
            <p>
              From coastal villas to penthouses, each system is custom-configured
              for your environment, lifestyle, and architectural vision.
            </p>
          </div>

          <div class="living-experience__showcase" aria-label="Indoor-outdoor living applications">
            <article
              class="living-card living-card--large"
              data-living-carousel
              data-slides={JSON.stringify([
                images.panoramic.src,
                "/images/optimized/florida-coastal-villa-02.webp",
                "/images/optimized/florida-coastal-villa-03.webp"
              ])}
            >
              <img
                class="living-card__image"
                src={images.panoramic.src}
                alt={images.panoramic.alt}
                width={images.panoramic.width}
                height={images.panoramic.height}
                loading="lazy"
              />
              <div class="living-card__content">
                <span>01</span>
                <div>
                  <h3>Florida Coastal Villas</h3>
                  <p>Seamless transitions to pools, ocean air, and sun-drenched outdoor living.</p>
                </div>
              </div>
              <div class="living-card__dots" aria-hidden="true"></div>
            </article>

            <article
              class="living-card"
              data-living-carousel
              data-slides={JSON.stringify([
                images.kitchen.src,
                "/images/optimized/california-indoor-outdoor-02.webp",
                "/images/optimized/california-indoor-outdoor-03.webp"
              ])}
            >
              <img
                class="living-card__image"
                src={images.kitchen.src}
                alt={images.kitchen.alt}
                width={images.kitchen.width}
                height={images.kitchen.height}
                loading="lazy"
              />
              <div class="living-card__content">
                <span>02</span>
                <div>
                  <h3>California Indoor-Outdoor Living</h3>
                  <p>Connect kitchens, lounges, and terraces for everyday living and entertaining.</p>
                </div>
              </div>
              <div class="living-card__dots" aria-hidden="true"></div>
            </article>

            <article
              class="living-card"
              data-living-carousel
              data-slides={JSON.stringify([
                "/images/optimized/penthouse-hospitality-01.webp",
                "/images/optimized/penthouse-hospitality-02.webp",
                "/images/optimized/penthouse-hospitality-03.webp"
              ])}
            >
              <img
                class="living-card__image"
                src="/images/optimized/penthouse-hospitality-01.webp"
                alt={images.hospitality.alt}
                width="1672"
                height="941"
                loading="lazy"
              />
              <div class="living-card__content">
                <span>03</span>
                <div>
                  <h3>Penthouses & Hospitality Lounges</h3>
                  <p>High-impact openings that elevate guest experiences and showcase the view.</p>
                </div>
              </div>
              <div class="living-card__dots" aria-hidden="true"></div>
            </article>
          </div>

          <div class="living-experience__note">
            <span aria-hidden="true">◇</span>
            <p>
              Each project is reviewed for opening size, wind exposure, panel weight,
              finish, glass package, and hardware configuration to ensure lasting
              performance in any environment.
            </p>
            <a href="#systems">Explore systems & engineering</a>
          </div>
        </div>
      </section>

      <section class="section feature-system" id="features" aria-labelledby="features-title">
        <div class="container feature-system__inner">
          <div class="section__intro">
            <p class="eyebrow">Feature system</p>
            <h2 id="features-title">Designed for the Details Architects Actually Care About</h2>
          </div>
          <div class="showcase-grid">
