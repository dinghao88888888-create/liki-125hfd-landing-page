---
import CTAButton from "../components/CTAButton.astro";
import FloatingNav from "../components/FloatingNav.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import ImageBlock from "../components/ImageBlock.astro";
import InquiryClientScript from "../components/InquiryClientScript.astro";
import InquiryForm from "../components/InquiryForm.astro";
import MicrosoftClarity from "../components/MicrosoftClarity.astro";
import PopupInquiryForm from "../components/PopupInquiryForm.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { images } from "../data/sections.js";
import "../styles/global.css";

const title =
  "Ultra-Large Folding Glass Door Systems | LIKI";
const description =
  "Explore LIKI 140 and 145 heavy-duty folding glass door systems for luxury homes, large openings, architects, builders, and custom projects.";
const siteUrl = "https://folding-glass-doors.likisystems.com";
const canonical = `${siteUrl}/`;
const heroImageUrl = `${siteUrl}/images/optimized/liki-125hfd-hero-folding-glass-wall-luxury-villa.webp`;

const navItems = [
  ["Why LIKI", "#open-living"],
  ["140 vs 145", "#systems"],
  ["Key Features", "#features"],
  ["Engineering", "#engineering"],
  ["Process", "#process"],
  ["Projects", "#projects"],
  ["Quote", "#quote"]
];

