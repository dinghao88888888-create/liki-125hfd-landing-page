const showcaseProjects = [
  {
    loc: "California",
    type: "Hospitality Lounge",
    feature: "Panoramic Indoor-Outdoor Dining",
    title: "Luxury Hospitality Lounge with Panoramic Folding Openings",
    text:
      "A refined hospitality lounge featuring oversized aluminum folding glass wall systems that fully open toward expansive sunset mountain views. Designed for premium indoor-outdoor dining experiences, the ultra-wide opening configuration creates seamless spatial continuity, minimal visual obstruction, and an elevated luxury hospitality atmosphere.",
